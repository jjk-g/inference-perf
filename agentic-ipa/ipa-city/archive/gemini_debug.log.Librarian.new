erence-checkpoint\n        resources:\n          limits:\n            google.com/tpu: 8\n          requests:\n            google.com/tpu: 8\n        volumeMounts:\n        - mountPath: /kaggle/\n          name: kaggle-credentials\n          readOnly: true\n      nodeSelector:\n        cloud.google.com/gke-tpu-accelerator: tpu-v5-lite-podslice\n        cloud.google.com/gke-tpu-topology: 2x4\n      restartPolicy: Never\n      volumes:\n      - name: kaggle-credentials\n        secret:\n          defaultMode: 256\n          secretName: kaggle-secret\n  ttlSecondsAfterFinished: 30\n\n\nLABELS: reply-to:ic-wisp-qcjp, thread:thread-7c6eef07bd08\n\nMETADATA\n  from: aipa_survey_packs.librarian-1\n  mail.from_display: aipa_survey_packs.librarian-1\n  mail.from_session_id: ic-mwkg\n  mail.to_display: aipa_survey_packs.librarian-1\n  mail.to_session_id: ic-rxd\n\nRELATED\n  ↔ ✓ ic-wisp-h3y5: Re: Research: gemma-7b-it-jetstream deployment ● P2\nProcess Group PGID: 1234437"}}}],"resultDisplay":"Output: ○ ic-wisp-874y · Re: Research: gemma-7b-it-jetstream deployment   [● P2 · OPEN]\nOwner: aipa_survey_packs__librarian-ic-1xaf · Assignee: ic-rxd · Type: message\nCreated: 2026-05-01 · Updated: 2026-05-01\n\nDESCRIPTION\napiVersion: v1\nkind: Service\nmetadata:\n  labels:\n    app: gemma-7b-it-jetstream-inference-server\n  name: gemma-7b-it-jetstream-service\nspec:\n  ports:\n  - name: jetstream-http\n    port: 8000\n    protocol: TCP\n    targetPort: 8000\n  - name: jetstream-grpc\n    port: 9000\n    protocol: TCP\n    targetPort: 9000\n  selector:\n    app: gemma-7b-it-jetstream-inference-server\n    deployment: gemma-7b-it-jetstream-deployment\n---\napiVersion: apps/v1\nkind: Deployment\nmetadata:\n  labels:\n    app: gemma-7b-it-jetstream-inference-server\n  name: gemma-7b-it-jetstream-deployment\nspec:\n  replicas: 2\n  selector:\n    matchLabels:\n      app: gemma-7b-it-jetstream-inference-server\n      deployment: gemma-7b-it-jetstream-deployment\n  template:\n    metadata: