path":{"type":"string","description":"(OPTIONAL) The path of the directory to run the command in. If not provided, the project root directory is used. Must be a directory within the workspace and must already exist."},"is_background":{"type":"boolean","description":"Set to true if this command should be run in the background (e.g. for long-running servers or watchers). The command will be started, allowed to run for a brief moment to check for immediate errors, and then moved to the background."},"delay_ms":{"type":"integer","description":"Optional. Delay in milliseconds to wait after starting the process in the background. Useful to allow the process to start and generate initial output before returning."}},"required":["command"]}},"status":"executing","startTime":1777606273131,"outcome":"proceed_once","invocation":{"params":"[Circular]"},"liveOutput":"○ ic-wisp-874y · Re: Research: gemma-7b-it-jetstream deployment   [● P2 · OPEN]\nOwner: aipa_survey_packs__librarian-ic-1xaf · Assignee: ic-rxd · Type: message\nCreated: 2026-05-01 · Updated: 2026-05-01\n\nDESCRIPTION\napiVersion: v1\nkind: Service\nmetadata:\n  labels:\n    app: gemma-7b-it-jetstream-inference-server\n  name: gemma-7b-it-jetstream-service\nspec:\n  ports:\n  - name: jetstream-http\n    port: 8000\n    protocol: TCP\n    targetPort: 8000\n  - name: jetstream-grpc\n    port: 9000\n    protocol: TCP\n    targetPort: 9000\n  selector:\n    app: gemma-7b-it-jetstream-inference-server\n    deployment: gemma-7b-it-jetstream-deployment\n---\napiVersion: apps/v1\nkind: Deployment\nmetadata:\n  labels:\n    app: gemma-7b-it-jetstream-inference-server\n  name: gemma-7b-it-jetstream-deployment\nspec:\n  replicas: 2\n  selector:\n    matchLabels:\n      app: gemma-7b-it-jetstream-inference-server\n      deployment: gemma-7b-it-jetstream-deployment\n  template:\n    metadata:\n      labels:\n        ai.gke.io/inference-server: jetstream\n        ai.gke.io/model: gemma-7b-it\n        app: gemma-7b-it-jetstream-inference-server\n        deployment: gemma-7b-it-jetstream-deployment\n        examples.ai.gke.io/source: blueprints\n    spec:\n      containers:\n      - args:\n        - model_name=gemma-7b\n        - tokenizer_path=assets/tokenizer.gemma\n        - per_device_batch_size=4\n        - max_prefill_predict_length=1024\n        - max_target_length=2048\n        - async_checkpointing=false\n        - ici_fsdp_parallelism=1\n        - ici_autoregressive_parallelism=-1\n        - ici_tensor_parallelism=1\n        - scan_layers=false\n        - weight_dtype=bfloat16\n        - load_parameters_path=gs://llama3-8b-jetstream/final/unscanned/gemma_7b-it/0/checkpoints/0/items\n        - prometheus_port=9100\n        env:\n        - name: TENSOR_PARALLEL_SIZE\n          value: \"8\"\n        image: us-docker.pkg.dev/cloud-tpu-images/inference/maxengine-server:v0.2.2\n        name: inference-server\n        ports:\n        - containerPort: 9100\n          name: metrics\n        - containerPort: 9000\n        resources:\n          limits:\n            google.com/tpu: 8\n          requests:\n            google.com/tpu: 8\n      - image: us-docker.pkg.dev/cloud-tpu-images/inference/jetstream-http:v0.2.2\n        name: jetstream-http\n        ports:\n        - containerPort: 8000\n      nodeSelector:\n        cloud.google.com/gke-tpu-accelerator: tpu-v5-lite-podslice\n        cloud.google.com/gke-tpu-topology: 2x4\n---\napiVersion: batch/v1\nkind: Job\nmetadata:\n  labels:\n    app: gemma-7b-it-jetstream-data-loader\n    prerequisite: model-load\n  name: gemma-7b-it-jetstream-data-loader\nspec:\n  template:\n    metadata:\n      labels:\n        app: gemma-7b-it-jetstream-data-loader\n    spec:\n      containers:\n      - args:\n        - -b=llama3-8b-jetstream\n        - -m=google/gemma/maxtext/7b-it/2\n        image: us-docker.pkg.dev/cloud-tpu-images/inference/inference-checkpoint:v0.2.2\n        name: inference-checkpoint\n        resources:\n          limits:\n            google.com/tpu: 8\n          requests:\n            google.com/tpu: 8\n        volumeMounts:\n        - mountPath: /kaggle/\n          name: kaggle-credentials\n          readOnly: true\n      nodeSelector:\n        cloud.google.com/gke-tpu-accelerator: tpu-v5-lite-podslice\n        cloud.google.com/gke-tpu-topology: 2x4\n      restartPolicy: Never\n      volumes:\n      - name: kaggle-credentials\n        secret:\n          defaultMode: 256\n          secretName: kaggle-secret\n  ttlSecondsAfterFinished: 30\n\n","pid":1234437,"schedulerId":"root","approvalMode":"yolo"}],"schedulerId":"root"}
